# Copia este archivo como ".env" (en la misma carpeta backend) y completa los valores reales.
# En Railway NO se sube este archivo: las variables se configuran desde el panel del servicio (pestaña "Variables").

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=sansley_app
DB_PASSWORD=
DB_NAME=sansley_db

# --- Autenticación ---
# Cadena larga y aleatoria. Nunca la compartas ni la subas a git.
JWT_SECRET=

# --- Servidor ---
# Railway define PORT automáticamente; en local puedes dejar 4000.
PORT=4000

# --- CORS (producción) ---
# URL(s) del frontend que pueden llamar a esta API, separadas por coma.
# En desarrollo se puede dejar vacío (usa http://localhost:5173 por defecto).
CORS_ORIGENES=
